# Copy to .env and edit. .env is gitignored.
# Before `docker compose build client`, run `bash tools/fetch-assets.sh`.

# ---- images ----
# Tag to pull/build. Use sha-<short> or v<version> to pin a specific build.
TAG=latest
AGENT_TAG=latest
# slim = HTTP LLM backends (openrouter/openai/none)
# codex = adds the codex CLI; also mount a logged-in ~/.codex
AGENT_TARGET=slim

# ---- ports ----
# Only the client is published. Put your TLS-terminating reverse proxy in
# front of this port; the game and REST ports stay on the compose network.
CLIENT_PORT=8080

# ---- terrain ----
# Region range baked into an empty volume, applied to both axes.
# 1 region = 1024 m. The default -2..1 is a 4x4 grid: ~3 minutes, ~1 GB.
# Widening the range barely changes the time (global erosion and road
# simulation dominate at ~3 minutes) but scales disk use by ~65 MB per region.
TERRAIN_REGION_MIN=-2
TERRAIN_REGION_MAX=1
# Set to 1 to re-bake even when a completed world is already present.
# TERRAIN_FORCE_BAKE=1

# ---- auth ----
# Google OAuth *Web* client id. Both services read it: the server verifies the
# ID token's aud, the client substitutes it into the already-built bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLI_CLIENT_ID=
# Comma-separated Google accounts allowed to use the map editor's REST writes.
# Leaving this empty means the NPC token alone grants write access — fine for a
# local trial, not for anything reachable from the internet.
ADMIN_EMAILS=
# Shared secret between the server and headless NPC clients.
# Leave empty and the server generates one into its state volume; the agent
# profile reads it from there via a read-only mount, so no manual step.
NPC_AUTH_TOKEN=

# ---- agent profile (docker compose --profile agent up) ----
OPENROUTER_API_KEY=
OPENAI_COMPAT_API_KEY=

# ---- logging ----
RUST_LOG=info
