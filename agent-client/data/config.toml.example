# Agent client configuration

# Server WebSocket URL. Straight to the game port on the server machine;
# through the public TLS front door from anywhere else, where the proxy only
# upgrades the /ws path (the bare host serves the game page instead):
#   server = "wss://openmmo.to.nexus/ws"
server = "ws://127.0.0.1:10006"

# Where heightmap tiles come from. A local terrain directory when running on
# the game server; an http(s):// server origin otherwise — the same public
# endpoint the web client reads, so no 3 GB tile tree to copy around.
# terrain = "https://openmmo.to.nexus"
terrain = "../data/terrain"

# Disk cache for tiles fetched over HTTP (ignored for a local terrain dir).
# terrain_cache = "data/cache/height"

# NPC auth token. Defaults to reading ../data/npc_token (generated by the
# server on first run); set here only when running on a different machine.
# npc_token = "..."

# NPC account name (must start with npc_); auto-created on first use.
account = "npc_example"

# Read-only spectator web panel, bound to 127.0.0.1. Off unless set. It serves
# the agent's map, event feed and full LLM prompts, so keep it off loopback.
# watch_port = 8808

# LLM backend to use: "none", "claude", "openrouter", "codex", "openai"
# - none: no LLM driver; schedule and monster AI drive the NPC on their own
# - claude: Claude CLI (stdio subprocess)
# - openrouter: OpenRouter API (HTTP, any model)
# - codex: Codex CLI (stdio subprocess)
# - openai: any OpenAI-compatible chat completions endpoint (HTTP)
llm = "none"

# LLM timing (seconds)
min_interval_secs = 5                       # Minimum seconds between prompts (active mode)
urgent_min_interval_secs = 2                # Same floor while an urgent event waits (player chat, being hit)
debounce_secs = 2                           # Extra wait to batch events after trigger
idle_interval_secs = 3600                   # Interval when no chat/combat activity (idle mode)
activity_window_secs = 30                   # How long after last activity to stay in active mode

# Keep thinking with no human player in sight. Defaults to true for the agent
# you run yourself — it spends your own LLM quota, and an agent that stops the
# moment it walks out of sight can never hunt a dungeon alone. Registry NPCs
# (`id = "..."`) default to false: they run on the server operator's budget,
# and an NPC nobody can see has no one to act for. Set per NPC to override.
# always_active = true

# Sprint on every walk while well fed (default). Off walks everywhere, which
# costs far less satiation. Individual actions can still opt out with
# "sprint": false.
# always_sprint = true

# LLM Scheduler: controls concurrent LLM calls across all NPCs
max_concurrent = 2                          # Max simultaneous LLM calls (min 1, default 2)
request_timeout_secs = 120                  # Give up on one call (0 = never); applies to every
                                            # backend, so a hung CLI or endpoint cannot hold a slot

# How this client authenticates to the game server.
#   npc_token — shared secret from the server's data/npc_token (default)
#   google    — the runner's own Google account, via the device flow: the
#               client prints a URL and a code to enter in any browser
[auth]
mode = "npc_token"
# client_id = "...apps.googleusercontent.com"  # defaults to the built-in CLI client
# client_secret = "..."                        # or GOOGLE_CLI_CLIENT_SECRET
# token_cache = "~/.config/onlinerpg/google.json"  # refresh token lives here (0600)

# Claude CLI settings (used when llm = "claude")
[claude]
model = "sonnet"                            # "sonnet", "opus", "haiku", or full model ID
system_prompt_file = "data/system_prompt.txt"  # Path to system prompt file

# OpenRouter API settings (used when llm = "openrouter")
# Uses OpenAI-compatible chat completions API to call any model available on OpenRouter.
[openrouter]
# api_key = "sk-or-..."                        # Or set OPENROUTER_API_KEY env var
model = "openrouter/hunter-alpha"              # Any model ID from openrouter.ai/models
system_prompt_file = "data/system_prompt.txt"
max_tokens = 1024                              # Max response tokens
temperature = 0.7

# Codex CLI settings (used when llm = "codex")
# Requires `codex` CLI installed (npm i -g @openai/codex) and OPENAI_API_KEY set.
[codex]
model = "gpt-5.4-mini"                                # Any OpenAI model ID
system_prompt_file = "data/system_prompt.txt"

# Generic OpenAI-compatible endpoint settings (used when llm = "openai")
# Any self-hosted or third-party gateway that speaks the OpenAI chat
# completions API — a LiteLLM proxy, vLLM, Ollama Cloud, opencode.ai Zen, etc.
[openai]
base_url = "https://ollama.com/v1"             # Origin + path prefix; code appends /chat/completions
# api_key = "..."                              # Or set OPENAI_COMPAT_API_KEY env var; omit if no auth needed
model = "minimax-m3"                           # Any model ID the endpoint accepts
system_prompt_file = "data/system_prompt.txt"
max_tokens = 1024                              # Max response tokens
temperature = 0.7
reasoning_effort = "none"                      # "none"/"low"/"medium"/"high"; "" omits it for models that reject it
max_messages = 41                              # History per call incl. system prompt; values under 3 are raised to 3

# --- Multi-NPC Orchestrator Mode ---
# When [[npcs]] is present, legacy single-NPC fields above are ignored.
# Each NPC gets its own WebSocket connection and LLM session.
#
# Who an NPC *is* lives in the game-data registry (data-src/npcs.csv) and the
# data/npcs/{id}/ directory; this file only picks which registry NPCs run on
# this instance and with what deployment values (account, llm, timing).
# With `id` set, these are derived from the registry:
#   character_name  = registry npcName
#   character_class = registry class
#   template_prompt = data/templates/{class}.txt
#   instance_prompt = data/npcs/{id}/instance.txt
#   memory_file     = data/npcs/{id}/memory.txt
#   favor_file      = data/npcs/{id}/favor.json
#   schedule_file   = data/npcs/{id}/schedule.json (when the file exists)
# gender = "female"  # optional; new characters default to male
# Any of them can still be set explicitly to override the convention, and an
# entry without `id` keeps working fully spelled out (ad-hoc NPCs).
#
# --- Prompt layering ---
# Every agent starts from system_prompt_file above: the JSON schema and the
# action types they all share. Its role file is appended on top and may add
# further actions, then instance_prompt. memory_file and favor_file are not
# baked in: the driver re-reads them into every prompt, so notes and favor
# written mid-session take effect without a restart.
#
# An agent with no `id` has no class template, so pick its role yourself.
# Two are shipped, or point at your own file:
#   template_prompt = "data/user_prompts/newcomer.txt"  # knows nothing; learns by playing
#   template_prompt = "data/user_prompts/veteran.txt"   # knows the mechanics and stat targets
# With template_prompt unset, data/user_prompt.txt is used when it exists —
# copy one of the above there to make it the default for every such agent.
#
# The role file also decides how picky the agent is when rolling its starting
# stats: it is shown each roll and answers accept/reroll, like a human working
# the web client's reroll button. Say so in prose there; the code only caps
# the number of rolls.

[[npcs]]
id = "karl"
account = "npc_guard"
llm = "codex"

# Per-NPC timing overrides (optional, defaults shown above)
# min_interval_secs = 5
# urgent_min_interval_secs = 2
# debounce_secs = 2
# idle_interval_secs = 3600
# activity_window_secs = 30
# always_active = false                      # registry NPCs default to this

[[npcs]]
id = "rica"
account = "npc_merchant"
llm = "codex"

# The square's busker. Like the other registry NPCs she only thinks when
# someone is in sight — a song nobody can hear is an LLM call for nothing.
[[npcs]]
id = "signe"
account = "npc_bard"
llm = "codex"

# Night merchant. Opens the stall after dark and sells only what a night
# traveller needs; off duty in the day, when Rica is awake to sell the rest.
# Driven by the schedule alone, so no LLM backend is required.
[[npcs]]
id = "wick"
account = "npc_night_merchant"
llm = "none"
