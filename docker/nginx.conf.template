# Serves the built client and proxies the game's two backend ports.
# Mirrors client/vite.config.ts so dev and container behave the same.
#
# Rendered to conf.d/default.conf at startup by the base image's envsubst
# entrypoint, which substitutes only *defined* env vars — the nginx runtime
# $vars below pass through untouched.
#
# After editing, run tools/check-nginx-conf.sh: a mistake here otherwise
# survives until a deploy, and a deploy disconnects every player.

# Uploaded cape prints are content-addressed, so a cached copy can never be
# wrong. Without this every client in a crowd pulls every print off the game
# process's disk (doc/CAPE_CUSTOMIZATION.md).
proxy_cache_path /var/cache/nginx/cape-textures levels=1:2
                 keys_zone=cape_textures:1m max_size=512m inactive=30d
                 use_temp_path=off;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Exported from /etc/resolv.conf by the base image (see
    # NGINX_ENTRYPOINT_LOCAL_RESOLVERS in client.Dockerfile). Hardcoding
    # Docker's 127.0.0.11 would break on any non-default network mode.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Resolving the upstream through a variable defers DNS to request time, so
    # nginx starts even while the server container is still coming up. A
    # literal proxy_pass host is resolved once at config load and would abort.
    set $backend server;

    client_max_body_size 32m;

    # Longer prefix than /api/, so it wins the match. Only GET and HEAD are
    # cached by default, which leaves the upload and the admin block alone.
    location /api/cape-texture/ {
        proxy_cache cape_textures;
        # Only a floor for responses that carry no freshness of their own; the
        # upstream's own max-age wins, and it is what bounds how long a blocked
        # print keeps being served.
        proxy_cache_valid 200 1h;
        # One upstream read per print when a crowd arrives together.
        proxy_cache_lock on;
        add_header X-Cache-Status $upstream_cache_status;
        proxy_pass http://$backend:10007;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://$backend:10007;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://$backend:10006;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Idle players must not be disconnected by the proxy.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Hashed filenames, so the bundle and its assets can be cached hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(glb|mp3|m4a|wasm|png|jpg|svg|woff2)$ {
        expires 30d;
        add_header Cache-Control "public";
    }

    # index.html carries the current asset hashes, so it must never be cached.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
