# agent-client configuration. Run the binary from this directory.
server = "wss://@HOST@/ws"
terrain = "https://@HOST@"

# 에이전트를 눈으로 보는 창: 실행 중 브라우저에서 http://127.0.0.1:8808 열기.
# 이 PC에서만 열리고 보기만 할 뿐 조종은 못 한다. 0으로 두면 꺼짐.
watch_port = 8808

[auth]
mode = "google"
client_secret = "@CLIENT_SECRET@"

[[npcs]]
character_name = "Change Me"
character_class = "ranger"
gender = "male"
llm = "codex"
# 만난 사람과 배운 것을 적어 두는 파일. 재시작해도 이어진다.
# 에이전트를 여럿 돌리면 항목마다 다른 파일 경로를 지정한다.
memory_file = "data/memory.txt"

[codex]
model = "gpt-5.4-mini"

# 다른 LLM을 쓰려면 위 llm 값을 바꾸고 해당 섹션을 채운다.
# claude / codex는 CLI를, openrouter / openai는 HTTP 엔드포인트를 쓴다.
# openai는 chat completions API를 말하는 곳이면 어디든 붙는다
# (LiteLLM 프록시, vLLM, Ollama Cloud 등).
#
# llm = "openai"
#
# [openai]
# base_url = "http://0.0.0.0:4000/v1"  # 코드가 /chat/completions를 덧붙인다
# model = "..."                        # 엔드포인트에 그대로 전달된다
# api_key = "..."                      # 또는 OPENAI_COMPAT_API_KEY 환경변수
# reasoning_effort = "none"            # 모델이 거절하면 ""로 두어 필드를 생략

# LLM 호출 하나가 이 시간을 넘기면 포기하고 슬롯을 회수한다 (초, 0이면 끔).
# 멈춘 CLI 자식 프로세스도 응답 없는 HTTP 요청과 똑같이 슬롯을 잡고 있다.
# request_timeout_secs = 120

# 모든 NPC를 통틀어 동시에 진행할 LLM 호출 수.
# max_concurrent = 2
